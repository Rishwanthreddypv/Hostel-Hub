{
  "name": "hostel-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node scripts/browser-qa.mjs",
    "format": "prettier --write src server tests scripts/*.mjs",
    "admin:create": "node server/create-admin.js",
    "db:seed": "node server/seed.js",
    "db:validate": "node scripts/seed-cli.mjs --validate",
    "db:fresh": "node scripts/seed-cli.mjs --fresh",
    "db:generate": "node scripts/build-seed-csv.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
