PORT=4000
APP_ORIGIN=http://localhost:5173
# sqlite works without installing a database. Use mysql with DATABASE_URL below.
DB_CLIENT=sqlite
DATABASE_PATH=./data/hostel-hub.sqlite
# DATABASE_URL=mysql://hostel:change-me@localhost:3306/hostel_hub
# Required in production; use at least 32 random characters.
JWT_SECRET=
DEMO_MODE=true
# Optional OpenAI-compatible AI service. With no key, a local search assistant is used.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
